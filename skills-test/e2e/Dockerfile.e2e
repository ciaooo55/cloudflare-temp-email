# Keep this version in sync with @playwright/test in package.json
FROM mcr.microsoft.com/playwright:v1.63.0-noble

RUN apt-get update && apt-get install -y curl netcat-openbsd && rm -rf /var/lib/apt/lists/*

WORKDIR /repo/skills-test/e2e

COPY skills-test/e2e/package.json skills-test/e2e/package-lock.json ./
RUN npm ci

COPY skills-test/e2e/ .

ENTRYPOINT ["bash", "/repo/skills-test/e2e/scripts/docker-entrypoint.sh"]
