FROM node:24-slim

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.10.0 --activate

WORKDIR /repo/app/worker

COPY app/worker/package.json app/worker/pnpm-lock.yaml ./
COPY app/worker/patches/ patches/
RUN pnpm install --frozen-lockfile

COPY app/worker/src/ src/
COPY app/shared/ /repo/app/shared/
COPY skills-test/e2e/fixtures/*.ts /repo/skills-test/e2e/fixtures/
RUN ln -s /repo/app/worker/node_modules /repo/skills-test/e2e/node_modules
COPY app/worker/tsconfig.json ./
ARG WRANGLER_TOML=skills-test/e2e/fixtures/wrangler.toml.e2e
COPY ${WRANGLER_TOML} wrangler.toml

EXPOSE 8787

CMD ["pnpm", "exec", "wrangler", "dev", "--port", "8787", "--ip", "0.0.0.0", "--test-scheduled"]
